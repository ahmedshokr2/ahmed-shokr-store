rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Replace this placeholder with the owner's Firebase Authentication UID.
    function isAdmin() { return signedIn() && request.auth.uid == 'REPLACE_WITH_ADMIN_UID'; }
    function expectedPrice(bundleId) {
      return bundleId == 'flex10400' ? 250 :
        bundleId == 'flex6500' ? 140 :
        bundleId == 'flex2600' ? 80 :
        bundleId == 'flex1300' ? 50 :
        bundleId == 'internet' ? 320 :
        bundleId == 'we20' ? 280 :
        bundleId == 'we30' ? 340 :
        bundleId == 'we40' ? 440 :
        bundleId == 'we50' ? 520 :
        bundleId == 'we60' ? 580 :
        bundleId == 'we70' ? 660 : -1;
    }
    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['ownerUid','customerEmail','name','phone','bundleId','bundleName','price','note','paymentMethod','paymentReference','paymentStatus','status','createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.customerEmail == request.auth.token.email
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string && request.resource.data.phone.size() >= 8 && request.resource.data.phone.size() <= 15
        && request.resource.data.bundleId is string
        && request.resource.data.price == expectedPrice(request.resource.data.bundleId)
        && request.resource.data.bundleName is string && request.resource.data.bundleName.size() <= 100
        && request.resource.data.note is string && request.resource.data.note.size() <= 300
        && request.resource.data.paymentMethod in ['instapay','vodafone_cash']
        && request.resource.data.paymentReference is string && request.resource.data.paymentReference.size() <= 100
        && request.resource.data.paymentStatus == 'بانتظار المراجعة'
        && request.resource.data.status == 'بانتظار المراجعة'
        && request.resource.data.createdAt == request.time;
      allow read: if signedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }
  }
}
